{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/agenda/:path*",
      "destination": "https://calendar.app.google/P7WYxWAZBaXdNvYq9",
      "permanent": false
    },
    {
      "source": "/talleres.html",
      "destination": "/talleres/",
      "permanent": true
    },
    {
      "source": "/cotizador.html",
      "destination": "/cotizador/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/talleres/",
      "destination": "/talleres.html"
    },
    {
      "source": "/cotizador/",
      "destination": "/cotizador.html"
    }
  ],
  "headers": [
    {
      "source": "/cotizador:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview/:path*/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/oficina/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/oficina/:path*/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/oficina/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
